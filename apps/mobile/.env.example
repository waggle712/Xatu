# Copy to apps/mobile/.env. Only EXPO_PUBLIC_* values reach the app, and they are
# visible to anyone with the app, so never put secrets here.
# Android emulator: http://10.0.2.2:3000 · physical phone: http://<your-mac-LAN-IP>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Error tracking and pilot analytics (leave empty locally; both are then switched off).
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_APP_ENV=development

# Development only: turn feature flags on without PostHog (comma-separated).
EXPO_PUBLIC_FLAG_OVERRIDES=

# Optional: Google Maps on Android (Maps SDK for Android key, restricted to in.xatu.app).
# Read at build time by app.config.ts, not shipped as EXPO_PUBLIC.
GOOGLE_MAPS_ANDROID_API_KEY=
