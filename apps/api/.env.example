# Copy to apps/api/.env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://xatu:xatu_local@localhost:5434/xatu?schema=public
REDIS_URL=redis://localhost:6380

# Firebase console > Project settings > General > Project ID
FIREBASE_PROJECT_ID=xatu-dev
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
TRUST_PROXY=0

# Development login: lets the app sign in with any +91 number and code 123456 before Firebase
# is set up. Set to true ONLY on your own laptop, never on staging or any shared server.
# The API refuses to start if this is true with NODE_ENV=production.
AUTH_DEV_BYPASS=false

# Error tracking (leave empty locally). Sentry project DSN, and the environment name.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Pilot analytics (leave empty locally). PostHog project API key and host.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Media. local = files in MEDIA_LOCAL_DIR served by the API (development only); r2 = Cloudflare.
PUBLIC_API_URL=http://localhost:3000
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=.media
# For MEDIA_STORAGE=r2 (staging/production):
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
MEDIA_PUBLIC_BASE_URL=
# The API container runs with RUN_WORKERS=false; the worker container (node dist/src/worker.js) with true.
RUN_WORKERS=true
