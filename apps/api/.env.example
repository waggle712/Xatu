# Copy to apps/api/.env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://xatu:xatu_local@localhost:5434/xatu?schema=public
REDIS_URL=redis://localhost:6380

# Firebase console > Project settings > General > Project ID
FIREBASE_PROJECT_ID=xatu-dev
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
TRUST_PROXY=0

# Local only: lets the app sign in with any +91 number and code 123456 before Firebase is set up.
# The API refuses to start if this is true with NODE_ENV=production.
AUTH_DEV_BYPASS=true
