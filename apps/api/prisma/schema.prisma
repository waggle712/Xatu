// Xatu database schema: first release (marketplace first).
//
// Follows the founder's architecture audit (10 Nov 2026):
// - marketplace first: no posts, reels, trust_scores or media_fingerprints yet
// - order status and payment status are separate state machines
// - append-only double-entry ledger for every money movement
// - stock is reserved during checkout (inventory_reservations)
// - purchase-time snapshots on orders and order items
//
// Conventions: UUIDv7 ids, money in integer paise, created_at/updated_at on every table,
// media stored as storage keys (never full URLs), region/city columns for later per-city launches.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserRole {
  buyer
  seller
  admin
}

enum Language {
  ta
  en
}

enum AccountStatus {
  active
  suspended
}

/// Shop lifecycle. Owners submit, pause and resume; admins approve, suspend and reinstate.
enum SellerStatus {
  draft
  kyc_pending
  active
  paused
  suspended
}

enum MediaPurpose {
  shop_cover
  product_photo
}

/// pending (ticket issued) → processing (worker) → ready | rejected
enum MediaStatus {
  pending
  processing
  ready
  rejected
}

enum VerificationStatus {
  unverified
  pending
  verified
  rejected
}

enum ProductStatus {
  draft
  active
  paused
  archived
}

/// Only `live` items are shown to buyers.
enum ModerationStatus {
  pending
  live
  held
  removed
}

enum FulfilmentMode {
  courier
  pickup
  local_delivery
}

/// Fulfilment lifecycle. Payment has its own lifecycle (PaymentStatus).
enum OrderStatus {
  draft
  awaiting_payment
  placed
  accepted
  preparing
  ready_for_pickup
  out_for_delivery
  completed
  expired
  cancelled_by_buyer
  cancelled_by_seller
  in_dispute
  refunded
  partially_refunded
}

enum PaymentStatus {
  initiated
  pending
  verified
  settlement_eligible
  settled
  failed
  expired
  refund_pending
  refunded
  disputed
  reversed
}

enum RefundStatus {
  requested
  approved
  processing
  completed
  rejected
  failed
}

/// Why a variant's stock changed. Every change writes one append-only stock_movements row.
enum StockMovementReason {
  listing_created
  seller_set
  order_sold
  order_cancelled
  admin_correction
}

enum ReservationStatus {
  active
  committed
  released
  expired
}

enum LedgerAccountType {
  asset
  liability
  revenue
  expense
}

enum LedgerDirection {
  debit
  credit
}

enum ReportTargetType {
  user
  seller
  product
  review
}

enum ReportStatus {
  open
  reviewing
  actioned
  dismissed
}

enum IdempotencyStatus {
  in_progress
  completed
}

enum DevicePlatform {
  android
  ios
}

// ───────────────────────────── Identity ─────────────────────────────

model User {
  id          String        @id @default(uuid(7)) @db.Uuid
  firebaseUid String        @unique @map("firebase_uid")
  phone       String        @unique
  name        String?
  language    Language      @default(ta)
  roles       UserRole[]    @default([buyer])
  status      AccountStatus @default(active)
  region      String        @default("IN-TN")
  city        String?
  deletedAt   DateTime?     @map("deleted_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  sessions           Session[]
  deviceTokens       DeviceToken[]
  consents           ConsentRecord[]
  sellerProfile      SellerProfile?
  addresses          Address[]
  ordersAsBuyer      Order[]                @relation("BuyerOrders")
  reservations       InventoryReservation[]
  reviews            Review[]
  reports            Report[]               @relation("Reporter")
  idempotencyRecords IdempotencyRecord[]
  cart               Cart?
  mediaAssets        MediaAsset[]
  savedProducts      SavedProduct[]
  follows            ShopFollow[]

  @@map("users")
}

/// Refresh-token sessions. Tokens are stored hashed and rotated on every refresh.
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  deviceName       String?   @map("device_name")
  ip               String?
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model DeviceToken {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  expoToken String         @unique @map("expo_token")
  platform  DevicePlatform
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

/// Evidence of notices accepted (DPDP Act): which document version, when.
model ConsentRecord {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  purpose     String
  version     String
  grantedAt   DateTime  @default(now()) @map("granted_at")
  withdrawnAt DateTime? @map("withdrawn_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("consent_records")
}

// ───────────────────────────── Profiles ─────────────────────────────

model SellerProfile {
  id                    String                                 @id @default(uuid(7)) @db.Uuid
  userId                String                                 @unique @map("user_id") @db.Uuid
  handle                String                                 @unique @db.Citext
  businessName          String                                 @map("business_name")
  storyEn               String?                                @map("story_en")
  storyTa               String?                                @map("story_ta")
  categoryId            String?                                @map("category_id") @db.Uuid
  /// Public locality shown to buyers, e.g. "Woraiyur".
  areaName              String?                                @map("area_name")
  city                  String
  region                String                                 @default("IN-TN")
  pincode               String?
  /// Exact pickup point (PostGIS, WGS 84). PRIVATE: public views only get a rounded location.
  location              Unsupported("geography(Point, 4326)")?
  /// PUBLIC: the exact point rounded to 2 decimals (about 1 km), written with `location`. Discovery
  /// (feed radius, distance, map pins) uses only this, so results can't reveal the exact spot.
  approxLocation        Unsupported("geography(Point, 4326)")? @map("approx_location")
  /// PRIVATE: shown to the owner, and to a buyer only after their order is accepted.
  pickupAddressLine     String?                                @map("pickup_address_line")
  pickupLandmark        String?                                @map("pickup_landmark")
  /// Weekly hours in IST, validated by openingHoursSchema in @xatu/shared.
  openingHours          Json                                   @default("{}") @map("opening_hours")
  coverMediaId          String?                                @map("cover_media_id") @db.Uuid
  pickupAvailable       Boolean                                @default(true) @map("pickup_available")
  localDelivery         Boolean                                @default(false) @map("local_delivery")
  courierAvailable      Boolean                                @default(false) @map("courier_available")
  /// Flat fee for local delivery, per order, set by the seller (0 = free).
  localDeliveryFeePaise BigInt                                 @default(0) @map("local_delivery_fee_paise")
  verificationStatus    VerificationStatus                     @default(unverified) @map("verification_status")
  verifiedAt            DateTime?                              @map("verified_at")
  status                SellerStatus                           @default(draft)
  submittedAt           DateTime?                              @map("submitted_at")
  createdAt             DateTime                               @default(now()) @map("created_at")
  updatedAt             DateTime                               @updatedAt @map("updated_at")

  user       User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  category   Category?    @relation(fields: [categoryId], references: [id])
  coverMedia MediaAsset?  @relation("ShopCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  products   Product[]
  orders     Order[]      @relation("SellerOrders")
  reviews    Review[]
  followers  ShopFollow[]

  @@index([city, status])
  @@index([pincode])
  @@index([location], type: Gist, map: "seller_profiles_location_gist_idx")
  @@index([approxLocation], type: Gist, map: "seller_profiles_approx_location_gist_idx")
  @@index([businessName(ops: raw("gin_trgm_ops"))], type: Gin, map: "seller_profiles_business_name_trgm_idx")
  @@map("seller_profiles")
}

/// A buyer following a maker. Owned by profiles.
model ShopFollow {
  userId    String   @map("user_id") @db.Uuid
  sellerId  String   @map("seller_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@id([userId, sellerId])
  @@index([userId, createdAt])
  @@index([sellerId])
  @@map("shop_follows")
}

// ───────────────────────────── Catalog ─────────────────────────────

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique
  nameEn    String   @map("name_en")
  nameTa    String   @map("name_ta")
  parentId  String?  @map("parent_id") @db.Uuid
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Category?       @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[]      @relation("CategoryTree")
  products Product[]
  sellers  SellerProfile[]

  @@map("categories")
}

model Product {
  id               String           @id @default(uuid(7)) @db.Uuid
  sellerId         String           @map("seller_id") @db.Uuid
  categoryId       String?          @map("category_id") @db.Uuid
  /// Null while a draft is being written; required to publish.
  title            String?
  titleTa          String?          @map("title_ta")
  description      String?
  descriptionTa    String?          @map("description_ta")
  sku              String?
  /// Made after the order (cakes, custom henna). Stock still limits how many can be ordered.
  madeToOrder      Boolean          @default(false) @map("made_to_order")
  /// Days from order to ready. Required when made_to_order (CHECK in the migration).
  leadTimeDays     Int?             @map("lead_time_days")
  /// Category-specific validated attributes (material, size, weight...).
  attributes       Json             @default("{}")
  fulfilmentModes  FulfilmentMode[] @default([pickup]) @map("fulfilment_modes")
  status           ProductStatus    @default(draft)
  moderationStatus ModerationStatus @default(pending) @map("moderation_status")
  /// First time the product went live. Set once; used to send product_listed only once.
  publishedAt      DateTime?        @map("published_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  seller       SellerProfile          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category     Category?              @relation(fields: [categoryId], references: [id])
  variants     ProductVariant[]
  media        ProductMedia[]
  orderItems   OrderItem[]
  reservations InventoryReservation[]
  savedBy      SavedProduct[]

  @@unique([sellerId, sku])
  @@index([sellerId, status])
  @@index([categoryId, status, moderationStatus])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_title_trgm_idx")
  @@index([titleTa(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_title_ta_trgm_idx")
  @@index([status, moderationStatus, publishedAt])
  @@map("products")
}

/// A buyable option of a product (size, flavour, weight). Every product has at least one.
/// Price and stock live here, never on the product.
model ProductVariant {
  id         String    @id @default(uuid(7)) @db.Uuid
  productId  String    @map("product_id") @db.Uuid
  /// Shown to buyers, e.g. "1 kg" / "1 கிலோ". Null for the single default variant.
  label      String?
  labelTa    String?   @map("label_ta")
  /// Validated by variantAttributesSchema in @xatu/shared (size, flavour, weight).
  attributes Json      @default("{}")
  pricePaise BigInt    @map("price_paise")
  /// Units on hand (CHECK >= 0). Only changed under a row lock, with a stock_movements row.
  stock      Int       @default(0)
  position   Int       @default(0)
  /// Removed variants are kept (orders point at them) but hidden.
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  product      Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  movements    StockMovement[]
  reservations InventoryReservation[]
  orderItems   OrderItem[]

  @@index([productId, position])
  @@map("product_variants")
}

/// Append-only history of every stock change. Never updated or deleted.
model StockMovement {
  id         String              @id @default(uuid(7)) @db.Uuid
  variantId  String              @map("variant_id") @db.Uuid
  delta      Int
  stockAfter Int                 @map("stock_after")
  reason     StockMovementReason
  actorId    String?             @map("actor_id") @db.Uuid
  createdAt  DateTime            @default(now()) @map("created_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
  @@map("stock_movements")
}

/// Up to 8 photos per product, in order. Each is a ready product_photo media asset owned by the seller.
model ProductMedia {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  mediaId   String   @unique @map("media_id") @db.Uuid
  position  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([productId, position])
  @@map("product_media")
}

/// A buyer's saved product (the heart). Owned by catalog. Kept while the product is paused or
/// sold out (prompt 25 sends back-in-stock alerts); the Saved list shows only public ones.
model SavedProduct {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
  @@map("saved_products")
}

// ───────────────────────────── Media ─────────────────────────────

/// An uploaded image. Only the storage key is stored; URLs are built when read, so the CDN can change.
model MediaAsset {
  id            String       @id @default(uuid(7)) @db.Uuid
  ownerId       String       @map("owner_id") @db.Uuid
  purpose       MediaPurpose
  status        MediaStatus  @default(pending)
  /// Where the phone uploads the original. Deleted after processing.
  uploadKey     String       @unique @map("upload_key")
  /// The cleaned image (EXIF stripped) that variants are made from. Set when ready.
  storageKey    String?      @unique @map("storage_key")
  declaredType  String       @map("declared_type")
  declaredBytes Int          @map("declared_bytes")
  contentType   String?      @map("content_type")
  byteSize      Int?         @map("byte_size")
  width         Int?
  height        Int?
  blurhash      String?
  capturedInApp Boolean      @default(false) @map("captured_in_app")
  rejectReason  String?      @map("reject_reason")
  attempts      Int          @default(0)
  readyAt       DateTime?    @map("ready_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  owner      User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  shopCovers SellerProfile[] @relation("ShopCover")
  productUse ProductMedia?

  @@index([ownerId, createdAt])
  @@index([status, createdAt])
  @@map("media_assets")
}

// ───────────────────────────── Orders ─────────────────────────────

model Address {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  name      String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String    @default("Tamil Nadu")
  pincode   String
  isDefault Boolean   @default(false) @map("is_default")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

/// Stock held for a buyer during checkout. Committed when payment is verified,
/// released when payment fails or the reservation expires.
/// The buyer's bag: one maker at a time. Owned by orders. Holds no stock (stock is held only
/// when an order is created, by inventory_reservations).
model Cart {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  sellerId  String   @map("seller_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model InventoryReservation {
  id        String            @id @default(uuid(7)) @db.Uuid
  productId String            @map("product_id") @db.Uuid
  variantId String            @map("variant_id") @db.Uuid
  buyerId   String            @map("buyer_id") @db.Uuid
  orderId   String?           @map("order_id") @db.Uuid
  quantity  Int
  status    ReservationStatus @default(active)
  expiresAt DateTime          @map("expires_at")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  buyer   User           @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  order   Order?         @relation(fields: [orderId], references: [id])

  @@index([productId, status])
  @@index([variantId, status])
  @@index([status, expiresAt])
  @@map("inventory_reservations")
}

model Order {
  id               String         @id @default(uuid(7)) @db.Uuid
  /// Short human code shown to buyers and sellers, e.g. XT-2041.
  code             String         @unique
  buyerId          String         @map("buyer_id") @db.Uuid
  sellerId         String         @map("seller_id") @db.Uuid
  status           OrderStatus    @default(awaiting_payment)
  fulfilmentMode   FulfilmentMode @map("fulfilment_mode")
  subtotalPaise    BigInt         @map("subtotal_paise")
  deliveryFeePaise BigInt         @default(0) @map("delivery_fee_paise")
  /// Commission over all items (seller-side; never added to what the buyer pays).
  commissionPaise  BigInt         @default(0) @map("commission_paise")
  /// When the order reached `completed` (pickup or delivery done). Settlement starts 48h later.
  completedAt      DateTime?      @map("completed_at")
  /// Unpaid orders stop holding stock at this time (awaiting_payment only).
  expiresAt        DateTime?      @map("expires_at")
  totalPaise       BigInt         @map("total_paise")
  /// Copy of the delivery address at purchase time (null for pickup).
  addressSnapshot  Json?          @map("address_snapshot")
  /// Copy of seller name, handle and pickup place at purchase time.
  sellerSnapshot   Json           @map("seller_snapshot")
  region           String         @default("IN-TN")
  city             String?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  buyer          User                   @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  seller         SellerProfile          @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  events         OrderEvent[]
  payments       Payment[]
  reservations   InventoryReservation[]
  refundRequests RefundRequest[]

  @@index([buyerId, createdAt])
  @@index([sellerId, status])
  @@index([status, expiresAt])
  @@map("orders")
}

model OrderItem {
  id               String   @id @default(uuid(7)) @db.Uuid
  orderId          String   @map("order_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  variantId        String   @map("variant_id") @db.Uuid
  /// Purchase-time copies, so later listing edits never change what was bought.
  titleSnapshot    String   @map("title_snapshot")
  titleTaSnapshot  String?  @map("title_ta_snapshot")
  variantSnapshot  String?  @map("variant_snapshot")
  unitPricePaise   BigInt   @map("unit_price_paise")
  quantity         Int
  lineTotalPaise   BigInt   @map("line_total_paise")
  commissionPaise  BigInt   @default(0) @map("commission_paise")
  /// Commission in basis points (500 = 5%) from the rule active at purchase time.
  commissionBps    Int      @map("commission_bps")
  commissionRuleId String?  @map("commission_rule_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant        ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  commissionRule CommissionRule? @relation(fields: [commissionRuleId], references: [id])
  review         Review?

  @@index([orderId])
  @@map("order_items")
}

/// Append-only history of every order status change.
model OrderEvent {
  id         String       @id @default(uuid(7)) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorId    String?      @map("actor_id") @db.Uuid
  note       String?
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_events")
}

// ───────────────────────────── Payments and ledger ─────────────────────────────

model Payment {
  id                String        @id @default(uuid(7)) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  provider          String        @default("razorpay")
  providerOrderId   String?       @unique @map("provider_order_id")
  providerPaymentId String?       @unique @map("provider_payment_id")
  status            PaymentStatus @default(initiated)
  amountPaise       BigInt        @map("amount_paise")
  currency          String        @default("INR")
  failureReason     String?       @map("failure_reason")
  verifiedAt        DateTime?     @map("verified_at")
  /// How it was verified: 'webhook' or 'fetch' (never the app).
  verifiedBy        String?       @map("verified_by")
  /// Last server-side fetch from Razorpay (the poller and on-demand checks).
  lastCheckedAt     DateTime?     @map("last_checked_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refundRequests RefundRequest[]

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

/// Every provider webhook, stored once by provider event id so replays are no-ops.
model PaymentWebhookEvent {
  id              String    @id @default(uuid(7)) @db.Uuid
  provider        String    @default("razorpay")
  providerEventId String    @map("provider_event_id")
  eventType       String    @map("event_type")
  payload         Json
  /// The exact bytes received, so the signature can be checked again later.
  rawBody         String    @map("raw_body")
  signature       String?
  signatureValid  Boolean   @map("signature_valid")
  attempts        Int       @default(0)
  processedAt     DateTime? @map("processed_at")
  outcome         String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Unique per provider event id among VALID events only (partial index in the migration), so
  // a forged request can never take a real event's id first.
  @@index([provider, providerEventId])
  @@index([processedAt, createdAt])
  @@map("payment_webhook_events")
}

model RefundRequest {
  id               String       @id @default(uuid(7)) @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  amountPaise      BigInt       @map("amount_paise")
  reason           String
  status           RefundStatus @default(requested)
  providerRefundId String?      @unique @map("provider_refund_id")
  /// Null for automatic (system) refunds.
  requestedById    String?      @map("requested_by_id") @db.Uuid
  failureReason    String?      @map("failure_reason")
  attempts         Int          @default(0)
  approvedById     String?      @map("approved_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("refund_requests")
}

/// Versioned commission rules; the rule in force at purchase time is copied to the order item.
model CommissionRule {
  id         String    @id @default(uuid(7)) @db.Uuid
  name       String
  categoryId String?   @map("category_id") @db.Uuid
  rateBps    Int       @map("rate_bps")
  validFrom  DateTime  @map("valid_from")
  validTo    DateTime? @map("valid_to")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  orderItems OrderItem[]

  @@index([categoryId, validFrom])
  @@map("commission_rules")
}

/// Chart of accounts: platform revenue, seller payables, provider clearing, TCS, TDS...
model LedgerAccount {
  id        String            @id @default(uuid(7)) @db.Uuid
  code      String            @unique
  name      String
  type      LedgerAccountType
  /// Set for per-seller payable accounts.
  sellerId  String?           @map("seller_id") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  entries LedgerEntry[]

  @@index([sellerId])
  @@map("ledger_accounts")
}

/// Groups balanced entries for one business event (payment verified, refund, payout...).
model LedgerTransaction {
  id             String   @id @default(uuid(7)) @db.Uuid
  /// What makes this transaction post exactly once, e.g. receipt:<paymentId>.
  idempotencyKey String   @unique @map("idempotency_key")
  kind           String
  /// What caused it, e.g. payment id or refund id. Unique per kind so it is posted once.
  referenceId    String   @map("reference_id")
  description    String?
  postedAt       DateTime @default(now()) @map("posted_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  entries LedgerEntry[]

  @@unique([kind, referenceId])
  @@map("ledger_transactions")
}

/// Append-only. Corrections are new reversing entries, never updates.
model LedgerEntry {
  id            String          @id @default(uuid(7)) @db.Uuid
  transactionId String          @map("transaction_id") @db.Uuid
  accountId     String          @map("account_id") @db.Uuid
  direction     LedgerDirection
  amountPaise   BigInt          @map("amount_paise")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

/// Stored responses for Idempotency-Key headers on money endpoints.
/// Idempotency-Key header records for mutating order and money endpoints.
model IdempotencyRecord {
  id           String            @id @default(uuid(7)) @db.Uuid
  key          String
  userId       String            @map("user_id") @db.Uuid
  endpoint     String
  requestHash  String            @map("request_hash")
  status       IdempotencyStatus @default(in_progress)
  responseCode Int?              @map("response_code")
  responseBody Json?             @map("response_body")
  expiresAt    DateTime          @map("expires_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint, key])
  @@map("idempotency_records")
}

// ───────────────────────────── Trust and safety ─────────────────────────────

/// Only for a delivered order item, by that order's buyer (enforced in the trust module).
model Review {
  id               String           @id @default(uuid(7)) @db.Uuid
  orderItemId      String           @unique @map("order_item_id") @db.Uuid
  buyerId          String           @map("buyer_id") @db.Uuid
  sellerId         String           @map("seller_id") @db.Uuid
  rating           Int
  body             String?
  photoKeys        String[]         @default([]) @map("photo_keys")
  moderationStatus ModerationStatus @default(live) @map("moderation_status")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  buyer     User          @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([sellerId, createdAt])
  @@map("reviews")
}

model Report {
  id          String           @id @default(uuid(7)) @db.Uuid
  reporterId  String           @map("reporter_id") @db.Uuid
  targetType  ReportTargetType @map("target_type")
  targetId    String           @map("target_id") @db.Uuid
  reason      String
  details     String?
  status      ReportStatus     @default(open)
  handledById String?          @map("handled_by_id") @db.Uuid
  resolution  String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Restrict)

  // One open report per reporter and target: partial unique index reports_one_open_per_target
  // (status open or reviewing) is in the migration; Prisma can't express partial indexes.
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

/// Every sensitive admin action (verification, suspension, refund approval...).
model AdminAuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  adminId    String   @map("admin_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([targetType, targetId])
  @@index([adminId, createdAt])
  @@map("admin_audit_logs")
}

// ───────────────────────────── Shared ─────────────────────────────

/// Written in the same transaction as the state change it describes; a worker publishes it.
model OutboxEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  topic       String
  aggregateId String    @map("aggregate_id")
  payload     Json
  attempts    Int       @default(0)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

/// Search: Latin spellings of common Tamil words (and back), so "murukku" finds "முறுக்கு".
model SearchTransliteration {
  id        String   @id @default(uuid(7)) @db.Uuid
  latin     String
  tamil     String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([latin, tamil])
  @@map("search_transliterations")
}

// ───────────────────────────── Ledger: rates, settlements, reconciliation ─────────────────────────────

/// Dated finance config (TCS, TDS, GST on commission). The rate in force on a date wins; the CA
/// changes a rate by adding a row with a new valid_from, never by editing code.
model FinanceRate {
  id        String    @id @default(uuid(7)) @db.Uuid
  key       String
  rateBps   Int       @map("rate_bps")
  /// What the rate applies to, e.g. items_incl_gst.
  base      String
  note      String?
  validFrom DateTime  @map("valid_from")
  validTo   DateTime? @map("valid_to")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([key, validFrom])
  @@map("finance_rates")
}

enum SettlementStatus {
  pending_approval
  approved
  exported
  paid
  cancelled
}

/// One seller's payout for one business day (IST), after the 48h dispute window.
model SettlementBatch {
  id                 String           @id @default(uuid(7)) @db.Uuid
  sellerId           String           @map("seller_id") @db.Uuid
  businessDay        DateTime         @map("business_day") @db.Date
  status             SettlementStatus @default(pending_approval)
  grossPaise         BigInt           @map("gross_paise")
  commissionPaise    BigInt           @map("commission_paise")
  commissionGstPaise BigInt           @map("commission_gst_paise")
  tcsPaise           BigInt           @map("tcs_paise")
  tdsPaise           BigInt           @map("tds_paise")
  netPaise           BigInt           @map("net_paise")
  approvedById       String?          @map("approved_by_id") @db.Uuid
  approvedAt         DateTime?        @map("approved_at")
  exportedAt         DateTime?        @map("exported_at")
  paidAt             DateTime?        @map("paid_at")
  /// Bank transfer reference (UTR) entered by finance when marking it paid.
  paymentReference   String?          @map("payment_reference")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  lines SettlementLine[]

  @@unique([sellerId, businessDay])
  @@index([status, businessDay])
  @@map("settlement_batches")
}

/// One order in a batch, with the rates it used. An order is settled once, ever.
model SettlementLine {
  id                 String   @id @default(uuid(7)) @db.Uuid
  batchId            String   @map("batch_id") @db.Uuid
  orderId            String   @unique @map("order_id") @db.Uuid
  itemsPaise         BigInt   @map("items_paise")
  deliveryPaise      BigInt   @map("delivery_paise")
  grossPaise         BigInt   @map("gross_paise")
  commissionPaise    BigInt   @map("commission_paise")
  commissionGstPaise BigInt   @map("commission_gst_paise")
  tcsPaise           BigInt   @map("tcs_paise")
  tdsPaise           BigInt   @map("tds_paise")
  netPaise           BigInt   @map("net_paise")
  tcsBps             Int      @map("tcs_bps")
  tdsBps             Int      @map("tds_bps")
  commissionGstBps   Int      @map("commission_gst_bps")
  /// The date whose rates were used (the order's completion time).
  ratesAt            DateTime @map("rates_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  batch SettlementBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([batchId])
  @@map("settlement_lines")
}

/// One nightly comparison with Razorpay's settlement report for a day.
model ReconciliationRun {
  id         String    @id @default(uuid(7)) @db.Uuid
  day        DateTime  @unique @db.Date
  items      Int       @default(0)
  issues     Int       @default(0)
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("reconciliation_runs")
}

/// Every item seen in a Razorpay settlement report (so a missing payment can be noticed).
model ReconciliationItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  entityId    String   @unique @map("entity_id")
  type        String
  amountPaise BigInt   @map("amount_paise")
  feePaise    BigInt   @map("fee_paise")
  taxPaise    BigInt   @map("tax_paise")
  settled     Boolean
  day         DateTime @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("reconciliation_items")
}

/// A mismatch between our records and Razorpay's (alerted once).
model ReconciliationIssue {
  id         String    @id @default(uuid(7)) @db.Uuid
  kind       String
  entityId   String    @map("entity_id")
  details    Json
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([kind, entityId])
  @@map("reconciliation_issues")
}
